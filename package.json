{
  "name": "appium-mobile-automation-framework",
  "version": "2.0.0",
  "description": "Enterprise-grade Cross-Platform Mobile Test Automation Framework for Android & iOS built with Appium 2.x, WebdriverIO 9, TypeScript, Page Object Model, W3C Actions, and Allure Reporting.",
  "main": "wdio.conf.ts",
  "type": "module",
  "scripts": {
    "test": "npm run test:android",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:android:apidemos": "wdio run ./wdio.android.conf.ts --spec ./test/specs/android/apidemos/**/*.spec.ts",
    "test:android:colornote": "wdio run ./wdio.android.conf.ts --spec ./test/specs/android/colornote/**/*.spec.ts",
    "test:android:gestures": "wdio run ./wdio.android.conf.ts --spec ./test/specs/android/apidemos/gestures.spec.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "test:ios:uikit": "wdio run ./wdio.ios.conf.ts --spec ./test/specs/ios/uikit/**/*.spec.ts",
    "test:ios:todo": "wdio run ./wdio.ios.conf.ts --spec ./test/specs/ios/todo/**/*.spec.ts",
    "test:crossplatform": "wdio run ./wdio.conf.ts --spec ./test/specs/cross-platform/**/*.spec.ts",
    "test:interview": "wdio run ./wdio.android.conf.ts --spec ./test/specs/interviews/**/*.spec.ts",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "report": "npm run report:generate && npm run report:open",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"test/**/*.{ts,js,json}\" \"*.ts\""
  },
  "keywords": [
    "appium",
    "appium2",
    "webdriverio",
    "wdio",
    "typescript",
    "page-object-model",
    "ios-automation",
    "android-automation",
    "xcuitest",
    "uiautomator2",
    "w3c-actions",
    "allure-report",
    "mobile-testing",
    "sdet-portfolio"
  ],
  "author": "Aman (Senior SDET / Mobile Automation Engineer)",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@wdio/allure-reporter": "^9.20.1",
    "@wdio/appium-service": "^9.20.1",
    "@wdio/cli": "^9.20.1",
    "@wdio/local-runner": "^9.20.1",
    "@wdio/mocha-framework": "^9.20.1",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.46.1",
    "appium-uiautomator2-driver": "^4.2.9",
    "dotenv": "^18.0.9",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
