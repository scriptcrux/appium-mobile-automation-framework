# ===============================================
# Appium Mobile Automation Framework - Environment Configuration
# ===============================================

# Target Platform ('android' | 'ios')
PLATFORM=android

# Logging verbosity ('trace' | 'debug' | 'info' | 'warn' | 'error' | 'silent')
LOG_LEVEL=info

# Appium Server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
MAX_INSTANCES=1

# Android Device Configuration
ANDROID_DEVICE_NAME=Pixel_6_API_34
ANDROID_PLATFORM_VERSION=14.0
ANDROID_APP=apidemos # Options: 'apidemos' | 'colornote'
ANDROID_APP_PATH=

# iOS Device Configuration
IOS_DEVICE_NAME=iPhone 15 Pro
IOS_PLATFORM_VERSION=17.4
IOS_APP=uikit # Options: 'uikit' | 'todo'
IOS_APP_PATH=

# Cloud Provider (BrowserStack / SauceLabs) - Optional
BS_USER=
BS_KEY=

